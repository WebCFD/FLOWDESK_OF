FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application       buoyantBoussinesqSimpleFoam;
startFrom         startTime;
startTime         0;
stopAt            endTime;
endTime           5000;
deltaT            1;
writeControl      timeStep;    // Write by iteration number
writeInterval     500;          // Write only at final iteration
adjustTimeStep    no;
purgeWrite        0;            // Keep all timesteps (0 and 500)
writeFormat       ascii;
writePrecision    6;
writeCompression  off;
timeFormat        general;
timePrecision     6;
runTimeModifiable true;         // Enable runtime modification for immediate writes

// functions{} removed - Allrun uses foamToVTK for VTK generation (0 + latestTime only)

